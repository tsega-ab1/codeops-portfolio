# Copy to .env.local and fill in real values. Never commit .env.local.

# --- SERVER ONLY (no NEXT_PUBLIC_ prefix) ---
SESSION_SECRET="replace-with-a-long-random-string"
DATABASE_URL="postgres://username:password@localhost/database"

# --- PUBLIC (inlined into browser JavaScript at build time; NOT secret) ---
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# Optional analytics script URL; leave empty to disable
NEXT_PUBLIC_ANALYTICS_SRC=""
