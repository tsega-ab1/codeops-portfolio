# Copy this file to .env and fill in the blanks. .env is never committed.
# error | warn | info | debug | verbose. Production runs at info.
LOG_LEVEL=info

# Two DIFFERENT secrets, each at least 32 characters. Generate one with:
#   node -p "require('crypto').randomBytes(48).toString('hex')"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Optional lifetimes: a number and one of s, m, h, d. The defaults are 15m and 7d.
# JWT_ACCESS_EXPIRES_IN=15m
# JWT_REFRESH_EXPIRES_IN=7d

# The password of the five development users (staff, almaz, dawit, kebede and abyssinia @example.et).
# At least 10 characters. Ignored in production, where no development users exist.
SEED_PASSWORD=

# CORS: the browser origins allowed to call this API, comma separated, exact, never *.
# Unset in development = http://localhost:5173 and http://localhost:3001. Unset in production = none.
# CORS_ORIGINS=https://addiseats.et,https://kitchen.addiseats.et

# Rate limits (all optional). Defaults: 600 requests a minute per address and route; login and refresh 5 per
# 15 minutes; registration 3 per hour. Keep the strict ones low in production.
# THROTTLE_LIMIT=600
# THROTTLE_STRICT_LIMIT=5
# THROTTLE_REGISTER_LIMIT=3
